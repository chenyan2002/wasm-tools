// Printable ASCII is written as a byte string
list-u8([72, 105, 32, 126]);
list-u8(b"Hi ~");
list-u8(b"\\\'\"");
// Tab, newline and carriage return count as text
list-u8([72, 105, 9, 10, 13]);
// Up to 10% other bytes are escaped
list-u8([97, 98, 99, 100, 101, 102, 103, 104, 105, 0]);
list-u8([101, 122, 111, 110, 101, 95, 97, 98, 98, 114, 101, 118, 105, 97, 116, 105, 111, 110, 34, 58, 34, 71, 77, 84, 34, 44, 34, 101, 108, 101, 118, 97, 116, 105, 111, 110, 34, 58, 56, 54, 46, 48, 44, 34, 99, 117, 114, 114, 101, 110, 116, 95, 117, 110, 105, 116, 115, 34, 58, 123, 34, 116, 105, 109, 101, 34, 58, 34, 105, 115, 111, 56, 54, 48, 49, 34, 44, 34, 105, 110, 116, 101, 114, 118, 97, 108, 34, 58, 34, 115, 101, 99, 111, 110, 100, 115, 34, 44, 34, 116, 101, 109, 112, 101, 114, 97, 116, 117, 114, 101, 95, 50, 109, 34, 58, 34, 194, 176, 67, 34, 44, 34, 119, 105, 110, 100, 95, 115]);
// Otherwise bytes are written as a list
list-u8([0, 127, 255]);
list-u8([34, 116, 101, 109, 112, 34, 58, 34, 194, 176, 67, 34]);
list-u8([97, 98, 99, 100, 101, 102, 103, 104, 0]);
list-u8(b"\t\n\r\u{0}\u{7f}");
list-u8(b"\x00\x7F\xff\x41");
// Empty
list-u8([]);
list-u8(b"");
// Nested
list-list-u8([b"abc", [1, 2], b"", [104, 105]]);
// Lists of other types are not written as byte strings
list-strings(["a"]);
list-chars(['a']);
// Map values
map-bool-list-u8({true: b"yes", false: [1, 2]});
